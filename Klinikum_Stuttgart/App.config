<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- Leer lassen = automatischer Demo-Modus (LocalDB/SQL Express).
             Fuer eine eigene Instanz z. B.:
             Data Source=.\SQLEXPRESS;Initial Catalog=Klinikum_Stuttgart;Integrated Security=True -->
        <add name="KlinikumConnectionString" connectionString="" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>